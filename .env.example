# Local environment template. Copy to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.

# Server-only secret. Read exclusively by app/api/github/repos/route.ts to
# raise the GitHub API rate limit for the public-repositories feed.
#
#   - NEVER prefix it with NEXT_PUBLIC_: Next.js inlines every NEXT_PUBLIC_*
#     variable into the client bundle, which would publish the token.
#   - NEVER log it, print it, or pass it to CI jobs or test runners.
#   - In production it is set once in Vercel (Settings > Environment
#     Variables), never in this repository.
#   - The app works without it (unauthenticated requests, lower rate limit).
GITHUB_TOKEN=
